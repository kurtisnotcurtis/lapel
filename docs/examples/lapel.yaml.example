# lapel desired-state manifest
# See internal/config/manifest.go for field documentation.

apiVersion: lapel.dev/v1
name: lapel-project

environment:
  distribution: Ubuntu-Lean
  base: ubuntu          # "ubuntu" or "debian"; defaults to "ubuntu"
  version: "24.04"      # pinned release; auto-selected default when omitted
  packages:             # extra apt packages beyond the built-in agent toolkit
    - ripgrep
    - fd-find
    - tree

provider:
  name: local
  type: lm-studio       # "lm-studio" | "ollama" | "openai-compatible"
  baseURL: "http://127.0.0.1:1234"
  connectionTimeout: 8s

agent:
  name: pi
  provider: local

workspace:
  name: workspace
  path: "."
  importMode: bind      # "bind" or "copy"

jail:
  name: developer
  profile: developer
  user: agent
  filesystem:
    "C:\\Users\\user\\Projects": read-write
    "C:\\Windows\\System32": deny
  network: unrestricted
  processes:
    privileged: false
    timeoutSeconds: 300
